# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
build/
.env
.env.local

# Model weights and caches.
# Anchored to ml/ — a bare "models/" also swallowed api/src/models/, which
# silently left every Mongoose schema out of the repo.
*.pt
*.bin
.cache/
/ml/models/

# Media and pipeline output — big, regenerable, never committed.
# Corpora are downloaded by scripts, so the manifest is enough to reproduce.
ml/data/samples/*
!ml/data/samples/.gitkeep
ml/data/fleurs/
ml/out/*
!ml/out/.gitkeep
!ml/out/*.manifest.json
*.mp4
*.mkv
*.wav
*.mp3

# OS / editor
.DS_Store
.idea/
.vscode/

# API
api/uploads/

# Frontend build output
web/dist/
api/clips/
ml/data/dict/

# Runtime logs
logs/
.chrome-profile/
desktop/node_modules/
