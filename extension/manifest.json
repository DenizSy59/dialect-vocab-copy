{
  "manifest_version": 3,
  "name": "Lexicon — vocabulary from streaming subtitles",
  "version": "0.1.0",
  "description": "Click words in Netflix, Prime Video and GagaOOLala subtitles to save them to your Lexicon deck.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.gagaoolala.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/watch/*",
        "https://www.primevideo.com/*",
        "https://www.gagaoolala.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lexicon"
  }
}
